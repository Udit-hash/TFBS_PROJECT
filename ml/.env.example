# Copy this file to ml/.env and fill in a key to enable the AI chatbot.
# Without a key, the chatbot still works in offline mode, answering from ml/chatbot/knowledge_base.json.
# ml/.env is git-ignored, so never commit your real key.

# --- Option A: Groq (free tier, fast) ---------------------------------
# Get a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Option B: Google Gemini (free tier) -------------------------------
# Get a key at https://aistudio.google.com/apikey
# LLM_API_KEY=your-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash

# Keep PyTorch light on laptops: max CPU threads used for predictions.
TORCH_NUM_THREADS=2
